<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.geometry.Rectangle2D?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.ScrollPane?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.control.TitledPane?>
<?import javafx.scene.image.Image?>
<?import javafx.scene.image.ImageView?>
<?import javafx.scene.layout.BorderPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.StackPane?>
<?import javafx.scene.layout.VBox?>

<BorderPane fx:id="mainPane" styleClass="main-background" stylesheets="@css/style.css" xmlns="http://javafx.com/javafx/26" xmlns:fx="http://javafx.com/fxml/1" fx:controller="br.com.dev.lukas.pomodorotimer.controller.HelloController">
   <center>
      <VBox fx:id="timerVBox" alignment="CENTER" BorderPane.alignment="CENTER">
         <children>
            <StackPane fx:id="battleContainer" prefHeight="250.0" prefWidth="300.0" styleClass="battle-container">
               <children>
                  <ImageView id="cenarioView" fx:id="cenarioView" pickOnBounds="true" smooth="false">
                     <image>
                        <Image url="@images/BattleBackgroundPokemon.jpeg" />
                     </image>
                  </ImageView>
                  <ImageView fx:id="imgMoita" fitWidth="100.0" pickOnBounds="true" preserveRatio="true" smooth="false" StackPane.alignment="BOTTOM_CENTER">
                     <viewport>
                        <Rectangle2D />
                     </viewport>
                     <image>
                        <Image url="@images/tallGrassPokemon.png" />
                     </image>
                  </ImageView>
                  <Label fx:id="labelTimer" alignment="CENTER" contentDisplay="CENTER" text="00:00" textAlignment="JUSTIFY" textFill="WHITE" textOverrun="CENTER_ELLIPSIS" StackPane.alignment="TOP_CENTER">

                  </Label>
               </children>
            </StackPane>
            <HBox fx:id="buttonsHbox" alignment="CENTER" spacing="10.0">
               <children>
                  <Button fx:id="buttonTimer" mnemonicParsing="false" onAction="#buttonClicked" prefHeight="60.0" prefWidth="60.0">
                     <graphic>
                        <ImageView fitHeight="30.0" fitWidth="30.0" pickOnBounds="true" preserveRatio="true">
                           <image>
                              <Image url="@images/right-arrow.png" />
                           </image>
                        </ImageView>
                     </graphic>
                  </Button>
                  <Button fx:id="skipStageButton" alignment="CENTER" mnemonicParsing="false" onAction="#onSkipStageButtonClicked" text=" ">
                     <graphic>
                        <ImageView fitHeight="30.0" fitWidth="30.0" pickOnBounds="true" preserveRatio="true">
                           <image>
                              <Image url="@images/next.png" />
                           </image>
                        </ImageView>
                     </graphic></Button>
               </children>
               <VBox.margin>
                  <Insets top="20.0" />
               </VBox.margin>
            </HBox>
         </children>
         <BorderPane.margin>
         </BorderPane.margin>
      </VBox>
   </center>
   <right>
      <VBox fx:id="rightPane" alignment="CENTER" maxHeight="1.7976931348623157E308" maxWidth="1.7976931348623157E308" BorderPane.alignment="CENTER">
         <children>
            <ScrollPane fitToHeight="true" fitToWidth="true" prefWidth="200.0" VBox.vgrow="ALWAYS">
               <content>
                  <VBox alignment="TOP_CENTER" spacing="10.0">
                     <children>
                        <Label text="Lista de tarefas" />
                        <TextField fx:id="inputTask" maxWidth="1.7976931348623157E308" onAction="#onAddTask" promptText="Digite a nova task aqui..." />
                        <TitledPane text="Em andamento">
                           <content>
                              <VBox fx:id="onGoingList" />
                           </content>
                        </TitledPane>
                        <TitledPane text="A fazer">
                           <content>
                              <VBox fx:id="toDoList" />
                           </content>
                        </TitledPane>
                        <TitledPane text="Concluidas">
                           <content>
                              <VBox fx:id="finishedList" />
                           </content>
                        </TitledPane>
                     </children>
                     <padding>
                        <Insets bottom="10.0" left="10.0" right="10.0" top="10.0" />
                     </padding>
                  </VBox>
               </content>
               <VBox.margin>
                  <Insets bottom="5.0" left="5.0" right="5.0" top="5.0" />
               </VBox.margin>
            </ScrollPane>
         </children>
      </VBox>
   </right>
   <left>
      <VBox fx:id="leftPane" alignment="TOP_CENTER" spacing="8.0" styleClass="sidebar" BorderPane.alignment="CENTER">
         <children>

            <Button fx:id="configurationButton" maxWidth="1.7976931348623157E308" mnemonicParsing="false" onAction="#onConfiguration" styleClass="sidebar-button" text="Config">
               <graphic>
                  <ImageView fitHeight="20.0" fitWidth="20.0" pickOnBounds="true" preserveRatio="true">
                     <image>
                        <Image url="@images/burger-menu.png" />
                     </image>
                  </ImageView>
               </graphic>
               <VBox.margin>
                  <Insets top="10.0" />
               </VBox.margin>
            </Button>
            <Button fx:id="timerButton" maxWidth="1.7976931348623157E308" mnemonicParsing="false" onAction="#openTimer" styleClass="sidebar-button" text="Timer">
               <graphic>
                  <ImageView fitHeight="20.0" fitWidth="20.0" pickOnBounds="true" preserveRatio="true">
                     <image>
                        <Image url="@images/alarm-clock.png" />
                     </image>
                  </ImageView>
               </graphic>
            </Button>
            <Button maxWidth="1.7976931348623157E308" mnemonicParsing="false" onAction="#onPokedex" styleClass="sidebar-button" text="Pokédex">
               <graphic>
                  <ImageView fitHeight="20.0" fitWidth="20.0" pickOnBounds="true" preserveRatio="true">
                     <image>
                        <Image url="@images/search-book.png" />
                     </image>
                  </ImageView>
               </graphic>
            </Button>
         </children>
         <padding>
            <Insets bottom="10.0" left="6.0" right="6.0" top="6.0" />
         </padding>
         <BorderPane.margin>
            <Insets right="20.0" />
         </BorderPane.margin>
      </VBox>
   </left>
</BorderPane>
