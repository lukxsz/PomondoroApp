<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.image.ImageView?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.VBox?>
<?import javafx.scene.layout.Region?>

<VBox alignment="TOP_CENTER" styleClass="pokemon-modal"
      stylesheets="@css/style.css"
      xmlns="http://javafx.com/javafx/26"
      xmlns:fx="http://javafx.com/fxml/1"
      fx:controller="br.com.dev.lukas.pomodorotimer.controller.PokemonDataController">
   <padding>
      <Insets bottom="15.0" left="15.0" right="15.0" top="15.0" />
   </padding>
   <children>
      <!-- HEADER: Número + Nome -->
      <HBox alignment="CENTER" spacing="8.0">
         <children>
            <Label fx:id="labelPokemonNumber" styleClass="pokemon-number" text="#025" />
            <Label fx:id="labelPokemonName" styleClass="pokemon-title" text="POKÉMON" />
         </children>
         <VBox.margin>
            <Insets bottom="2.0" top="5.0" />
         </VBox.margin>
      </HBox>

      <!-- SUBTITLE: Categoria -->
      <Label fx:id="labelCategory" styleClass="pokemon-category" text="Mouse Pokémon" />

      <!-- CORPO: Sprite + Info -->
      <HBox alignment="CENTER" spacing="15.0">
         <VBox.margin>
            <Insets top="10.0" />
         </VBox.margin>
         <children>
            <!-- Coluna da Imagem -->
            <VBox alignment="CENTER" minWidth="180.0">
               <children>
                  <ImageView fx:id="imagePokemon" fitHeight="150.0" fitWidth="180.0"
                             pickOnBounds="true" preserveRatio="true" />
               </children>
            </VBox>

            <!-- Coluna de Info -->
            <VBox alignment="TOP_LEFT" spacing="8.0" styleClass="pokemon-info-box">
               <padding>
                  <Insets bottom="10.0" left="12.0" right="12.0" top="10.0" />
               </padding>
               <children>
                  <!-- Tipos -->
                  <HBox spacing="6.0">
                     <children>
                        <Label fx:id="labelType1" styleClass="type-badge" text="TIPO 1" />
                        <Label fx:id="labelType2" styleClass="type-badge" text="TIPO 2" />
                     </children>
                  </HBox>

                  <!-- Separador visual -->
                  <Region prefHeight="5.0" />

                  <!-- Height -->
                  <HBox spacing="5.0">
                     <children>
                        <Label styleClass="pokemon-stat-label" text="Height:" />
                        <Label fx:id="labelHeight" styleClass="pokemon-stat-value" text="0.4 m" />
                     </children>
                  </HBox>

                  <!-- Weight -->
                  <HBox spacing="5.0">
                     <children>
                        <Label styleClass="pokemon-stat-label" text="Weight:" />
                        <Label fx:id="labelWeight" styleClass="pokemon-stat-value" text="6.0 kg" />
                     </children>
                  </HBox>
               </children>
            </VBox>
         </children>
      </HBox>

      <!-- DESCRIÇÃO DA POKÉDEX -->
      <Label fx:id="labelPokedexEntry" maxWidth="420.0" styleClass="pokedex-description"
             text="Pokédex entry..." wrapText="true">
         <VBox.margin>
            <Insets top="12.0" />
         </VBox.margin>
      </Label>
   </children>
</VBox>
