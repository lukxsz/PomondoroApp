<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.Spinner?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.VBox?>
<?import javafx.scene.text.Font?>

<VBox fx:id="configScreen" alignment="TOP_CENTER" maxWidth="1.7976931348623157E308" prefHeight="400.0" prefWidth="600.0" spacing="20.0" xmlns="http://javafx.com/javafx/25" xmlns:fx="http://javafx.com/fxml/1" fx:controller="br.com.dev.lukas.pomodorotimer.controller.SettingsController">
   <children>
      <Label alignment="CENTER" maxWidth="1.7976931348623157E308" />
      <Label alignment="CENTER" layoutX="10.0" layoutY="10.0" maxWidth="1.7976931348623157E308" text="Tempo (minutos)">
         <VBox.margin>
            <Insets />
         </VBox.margin>
         <font>
            <Font name="System Bold" size="12.0" />
         </font>
      </Label>
      <HBox alignment="CENTER" maxHeight="-Infinity" maxWidth="1.7976931348623157E308" prefHeight="100.0" prefWidth="200.0">
         <children>
            <Label text="Tempo de Foco ">
               <padding>
                  <Insets left="15.0" right="10.0" />
               </padding>
            </Label>
            <TextField fx:id="inputFocusDuration" />
         </children>
      </HBox>
      <HBox alignment="CENTER" maxHeight="-Infinity" maxWidth="1.7976931348623157E308" prefHeight="100.0" prefWidth="200.0">
         <children>
            <Label text="Tempo de Pausa">
               <padding>
                  <Insets left="15.0" right="25.0" />
               </padding>
            </Label>
            <TextField fx:id="inputBreakDuration" />
         </children>
      </HBox>
      <HBox alignment="CENTER" layoutX="10.0" layoutY="84.0" maxHeight="-Infinity" maxWidth="1.7976931348623157E308" prefHeight="100.0" prefWidth="200.0">
         <children>
            <Label text="Tempo de Pausa Longa">
               <padding>
                  <Insets left="15.0" right="10.0" />
               </padding>
            </Label>
            <TextField fx:id="inputFocusDuration1" />
         </children>
      </HBox>
      <HBox alignment="CENTER" maxHeight="-Infinity" maxWidth="1.7976931348623157E308" prefHeight="100.0" prefWidth="200.0">
         <children>
            <Label text="Quantidade de Intervalos">
               <padding>
                  <Insets right="5.0" />
               </padding>
            </Label>
            <Spinner fx:id="numberBreakSpinner" editable="true" />
         </children>
      </HBox>
      <HBox alignment="CENTER" maxHeight="-Infinity" maxWidth="1.7976931348623157E308" prefHeight="100.0" prefWidth="200.0">
         <children>
            <Button fx:id="saveChangesButton" mnemonicParsing="false" onAction="#onSavedChanges" text="Salvar">
               <font>
                  <Font size="14.0" />
               </font>
            </Button>
         </children>
      </HBox>
   </children>
</VBox>
